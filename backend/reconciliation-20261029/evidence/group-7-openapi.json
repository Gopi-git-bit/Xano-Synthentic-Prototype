                          "version": {
                            "type": "integer",
                            "format": "int64",
                            "description": "Server-managed aggregate version for optimistic concurrency control",
                            "default": "1"
                          },
                          "payment_mode": {
                            "type": "string",
                            "description": "Selected payment mode for freight haulage",
                            "enum": [
