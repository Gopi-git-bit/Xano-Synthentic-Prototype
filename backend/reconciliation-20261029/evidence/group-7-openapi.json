                            "format": "int64",
                            "description": "Shipper customer organization placing the booking"
                          },
                          "status": {
                            "type": "string",
                            "description": "Freight order operational lifecycle state",
                            "enum": [
                              "draft",
                              "quoted",
                              "booked",
