{
  "openapi": "3.0.3",
  "info": {
    "title": "Zippy Logistics \u2014 Backend Recovery Contracts",
    "version": "0.1.1-draft",
    "description": "Recovery-scope contracts for the components authored in the Backend Recovery programme. Registration and admin reads are additive. No existing endpoint's contract is changed by this document except where an explicit DELTA note says so.\n",
    "x-deployment_status": "NOT_DEPLOYED",
    "x-runtime_verified": false,
    "x-environment": "isolated-sandbox-only",
    "x-source_revision": "workspace-3-branch-v1 (85 xs definitions, read-only)",
    "x-frontend_revision": "f97e0af1db8b6b1b03bfa313d0d46ba4615944d6 (reported, not retrieved)",
    "x-machine_validated": false
  },
  "servers": [
    {
      "url": "https://{instance-host}/api:zippy-v1",
      "description": "API group Zippy_V1, canonical \"zippy-v1\". Host and the /api:<canonical> prefix are environment-derived; the exact prefix must be read from $env.$api_baseurl at runtime and is UNVERIFIED offline.\n",
      "variables": {
        "instance-host": {
          "default": "sandbox-host"
        }
      }
    },
    {
      "url": "https://{instance-host}/api:pofBqnrY",
      "description": "API group Authentication, canonical \"pofBqnrY\" (opaque, pre-existing). Registration is bound here so it does not alter the Zippy_V1 canonical surface.\n",
      "variables": {
        "instance-host": {
          "default": "sandbox-host"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "registration",
      "description": "New customer onboarding. Additive; replaces nothing at the contract level."
    },
    {
      "name": "admin-reads",
      "description": "Platform staff reads. Conservative allowlist only."
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "registration"
        ],
        "operationId": "registerCustomer",
        "summary": "Create customer account, organization, owner membership and KYB review request",
        "description": "Additive endpoint. Does NOT return an authentication token and is NOT compatible with the removed signup form or with the existing auth/signup + auth/login pair. A client must complete POST /api:pofBqnrY/auth/login separately to obtain a token. The created organization is draft-only: quoting, payment, consent and dispatch are refused until a human officer records KYB verification.\n",
        "security": [],
        "x-api-group": "Authentication",
        "x-api-group-canonical": "pofBqnrY",
        "x-verb": "POST",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCustomerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered. Draft-only until verification.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterCustomerResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "description": "Reserved. Rate limiting is NOT implemented; declared for forward compatibility only."
          }
        }
      }
    },
    "/admin/bookings": {
      "get": {
        "tags": [
          "admin-reads"
        ],
        "operationId": "adminListBookings",
        "summary": "Tenant-scoped booking read for platform staff",
        "description": "Conservative allowlist. Only super_admin and operations_admin may call this. support_agent is NOT supported in 0.1.1 (see x-policy-open-2). Read-only: performs no writes.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-api-group": "Zippy_V1",
        "x-api-group-canonical": "zippy-v1",
        "x-verb": "GET",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "draft",
                "quoted",
                "booked",
                "assigned",
                "in_transit",
                "delivered",
                "completed",
                "cancelled"
              ]
            }
          },
          {
            "name": "organization_id",
            "in": "query",
            "required": false,
            "description": "REQUIRED for operations_admin (explicit target-organization grant). OPTIONAL for super_admin; omitted means all tenants.\n",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Envelope differs by persona. super_admin receives amounts; operations_admin receives the base projection (see x-policy-open-1). Neither receives addresses, consignee data, free text or user identifiers.\n",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BookingListResponseBase"
                    },
                    {
                      "$ref": "#/components/schemas/BookingListResponseFinancial"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/bookings/{booking_id}/transitions": {
      "post": {
        "tags": [
          "admin-reads"
        ],
        "operationId": "commitBookingTransition",
        "summary": "Legal, versioned booking status transition",
        "description": "Additive endpoint wrapping the commit_versioned_status function. Validates trusted actor, tenant ownership, action permission and legal transition before any state change. Every committed transition writes exactly one audit_log row in the same transaction.\n",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-api-group": "Zippy_V1",
        "x-api-group-canonical": "zippy-v1",
        "x-verb": "POST",
        "parameters": [
          {
            "name": "booking_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingTransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Committed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingTransitionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "expected_version is stale. NOTE: whether the conflict surface as 409 depends on the platform's mapping of the thrown \"conflict\" / inputerror error_type. UNVERIFIED.\n"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Xano-issued user token. Supplied as Authorization Bearer."
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation or business-rule failure.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Authenticated but not authorized.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Uniformly returned for both missing and foreign-owned tenant resources, so callers cannot distinguish \"does not exist\" from \"belongs to another tenant\".\n",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "badrequest",
              "accessdenied",
              "notfound",
              "inputerror",
              "unauthorized",
              "conflict"
            ]
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "nullable": true,
            "description": "Present only if the platform supplies a trace id. UNVERIFIED."
          }
        }
      },
      "RegisterCustomerRequest": {
        "type": "object",
        "required": [
          "name",
          "email",
          "password",
          "organization_name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "Must contain a letter and a digit."
          },
          "organization_name": {
            "type": "string",
            "minLength": 1
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "requested_system_role": {
            "type": "string",
            "nullable": true,
            "description": "MUST be omitted. Any non-null value is rejected with 403. Retained in the schema only so that a client sending it receives a deterministic refusal.\n"
          }
        }
      },
      "RegisterCustomerResponse": {
        "type": "object",
        "required": [
          "user_id",
          "organization_id",
          "system_role",
          "status",
          "booking_scope",
          "approval_request_id",
          "verification_state"
        ],
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "organization_id": {
            "type": "integer"
          },
          "system_role": {
            "type": "string",
            "enum": [
              "customer_admin"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active"
            ]
          },
          "booking_scope": {
            "type": "string",
            "enum": [
              "draft_only"
            ]
          },
          "approval_request_id": {
            "type": "integer"
          },
          "verification_state": {
            "type": "string",
            "enum": [
              "pending_human_review"
            ]
          }
        },
        "description": "No authToken by design. Clients must call POST /api:pofBqnrY/auth/login to obtain one.\n"
      },
      "BookingTransitionRequest": {
        "type": "object",
        "required": [
          "action",
          "expected_version"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "confirm",
              "cancel",
              "assign",
              "start",
              "deliver",
              "close"
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "BookingTransitionResponse": {
        "type": "object",
        "required": [
          "booking_id",
          "action",
          "from_status",
          "status",
          "version",
          "transitioned"
        ],
        "additionalProperties": false,
        "properties": {
          "booking_id": {
            "type": "integer"
          },
          "action": {
            "type": "string"
          },
          "from_status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "version": {
            "type": "integer"
          },
          "transitioned": {
            "type": "boolean"
          }
        }
      },
      "Paging": {
        "type": "object",
        "required": [
          "page",
          "per_page",
          "total_items"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "per_page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total_items": {
            "type": "integer",
            "minimum": 0
          },
          "total_pages": {
            "type": "integer",
            "minimum": 0,
            "nullable": true
          }
        },
        "x-runtime-confirmation-required": true,
        "description": "Keyboard names are the intended contract. The exact key names emitted by the platform's paging serializer (totals: true) have NOT been observed and must be confirmed at runtime before the frontend depends on them.\n"
      },
      "BookingItemBase": {
        "type": "object",
        "required": [
          "id",
          "booking_reference",
          "status",
          "payment_status",
          "payment_mode",
          "currency",
          "version",
          "created_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer"
          },
          "booking_reference": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "payment_status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "payment_mode": {
            "$ref": "#/components/schemas/PaymentMode"
          },
          "matching_status": {
            "$ref": "#/components/schemas/MatchingStatus"
          },
          "pickup_city": {
            "type": "string"
          },
          "delivery_city": {
            "type": "string"
          },
          "pickup_window_start": {
            "type": "string",
            "format": "date-time"
          },
          "delivery_window_end": {
            "type": "string",
            "format": "date-time"
          },
          "currency": {
            "type": "string",
            "example": "INR"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "description": "Deliberately excluded: pickup_address, delivery_address, consignee_details, special_instructions, booked_by_user_id. Excluded fields must never be added to this schema without a new projection-policy review.\n"
      },
      "BookingItemFinancial": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BookingItemBase"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "total_amount": {
                "type": "number"
              },
              "quote_amount": {
                "type": "number"
              }
            }
          }
        ],
        "description": "Adds money fields. super_admin only under 0.1.1."
      },
      "BookingListResponseBase": {
        "type": "object",
        "required": [
          "items",
          "paging",
          "projection"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemBase"
            }
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          },
          "projection": {
            "type": "string",
            "enum": [
              "base"
            ]
          }
        },
        "description": "No policy internals (grant basis, access tier) are returned."
      },
      "BookingListResponseFinancial": {
        "type": "object",
        "required": [
          "items",
          "paging",
          "projection"
        ],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemFinancial"
            }
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          },
          "projection": {
            "type": "string",
            "enum": [
              "financial"
            ]
          }
        }
      },
      "BookingStatus": {
        "type": "string",
        "description": "PERSISTED enum on customer_booking.status. Eight values. This is the only booking state that exists in the database.",
        "enum": [
          "draft",
          "quoted",
          "booked",
          "assigned",
          "in_transit",
          "delivered",
          "completed",
          "cancelled"
        ]
      },
      "WorkflowDisplayState": {
        "type": "string",
        "description": "DERIVED, DISPLAY-ONLY. Never persisted; produced by orders/workflow_state from persisted columns. Must not be accepted as input anywhere.\n",
        "enum": [
          "draft",
          "payment_pending",
          "topay_consent_pending",
          "confirmed",
          "matching",
          "assigned",
          "in_transit",
          "delivered",
          "pod_uploaded",
          "settlement_pending",
          "closed",
          "on_hold",
          "cancelled",
          "exception",
          "topay_consent_denied"
        ]
      },
      "PaymentStatus": {
        "type": "string",
        "description": "PERSISTED on customer_booking.payment_status. Independent of booking status.",
        "enum": [
          "pending",
          "authorized",
          "paid_escrow",
          "settled",
          "refunded",
          "failed"
        ]
      },
      "PaymentMode": {
        "type": "string",
        "enum": [
          "prepaid",
          "topay",
          "credit"
        ],
        "description": "credit is persisted by enum but rejected by booking/confirm_booking as unsupported."
      },
      "MatchingStatus": {
        "type": "string",
        "enum": [
          "unmatched",
          "searching",
          "matched",
          "accepted",
          "rejected"
        ]
      },
      "ConsentDecision": {
        "type": "string",
        "description": "PERSISTED on topay_consent_attempts.decision. Independent of booking status.",
        "enum": [
          "pending",
          "accepted",
          "denied",
          "expired"
        ]
      },
      "PodStatus": {
        "type": "string",
        "description": "PERSISTED on proof_of_delivery.status. Independent of booking status.",
        "enum": [
          "pending",
          "submitted",
          "under_review",
          "approved",
          "rejected"
        ]
      },
      "TripStatus": {
        "type": "string",
        "description": "PERSISTED on trip.status. Independent of booking status.",
        "enum": [
          "assigned",
          "driver_en_route_pickup",
          "arrived_pickup",
          "loading",
          "in_transit",
          "arrived_delivery",
          "unloading",
          "pod_pending",
          "completed",
          "cancelled"
        ]
      },
      "SettlementStatus": {
        "type": "string",
        "description": "PERSISTED on settlement.status.",
        "enum": [
          "pending",
          "processing",
          "paid",
          "failed",
          "cancelled"
        ]
      }
    }
  }
}
